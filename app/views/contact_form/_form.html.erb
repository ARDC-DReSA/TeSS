<%= form_with scope: :contact_form, url: contact_form_index_path, method: :post, local: true do |form| %>
  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= form.label :phone %>
    <%= form.text_field :phone, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= form.label :email %>
    <%= form.email_field :email, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= form.label :type, "Message type" %>
    <%= form.select :type, [["request new feature", "request new feature"], ["report bug", "report bug"], ["general", "general"], ["complaint", "complaint"], ["feedback", "feedback"]], { selected: "general" }, { class: "form-control", style: "max-width: 260px;" } %>
  </div>
  <div class="form-group">
    <%= form.label :message %>
    <%= form.text_area :message, class: "form-control", rows: 5 %>
  </div>
  <%= form.submit "Submit", class: "btn btn-primary" %>
<% end %>
