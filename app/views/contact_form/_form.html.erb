<%= form_with scope: :contact_form, url: contact_form_index_path, method: :post, local: true do |form| %>
  <div class="form-group">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= form.label :phone %>
    <%= form.text_field :phone, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= form.label :email %>
    <%= form.email_field :email, class: "form-control" %>
  </div>
  <div class="form-group">
    <%= form.label :type, "Message type" %>
    <%= form.select :type, [["request new feature", "request new feature"], ["report bug", "report bug"], ["general", "general"], ["complaint", "complaint"], ["feedback", "feedback"]], { selected: "general" }, { class: "form-control", style: "max-width: 260px;" } %>
  </div>
  <div class="form-group">
    <%= form.label :message %>
    <%= form.text_area :message, class: "form-control", rows: 5 %>
  </div>
  <%# DReSA spam check (Oct 2026): a box people never see (robots fill it in), and a signed
      timestamp of when this page was shown. See ContactFormController. %>
  <div style="position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden;" aria-hidden="true">
    <%= form.label :website, "Leave this field empty" %>
    <%= form.text_field :website, tabindex: "-1", autocomplete: "off", value: "" %>
  </div>
  <%= form.hidden_field :rendered_at, value: Rails.application.message_verifier(:contact_form).generate(Time.now.to_i) %>
  <%= form.submit "Submit", class: "btn btn-primary" %>
<% end %>
