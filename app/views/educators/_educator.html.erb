<%# DReSA educator tile, using upstream's standard card pattern (see
    collections/_collection.html.erb): the whole card is one link-overlay
    link, so it looks and behaves like every other tile in the app.
    Opens the educator itself in a new tab. %>
<li class="masonry-brick media-item educator-tile">
  <%= link_to educator.url, class: 'link-overlay', target: '_blank', rel: 'noopener',
              title: "Open #{educator.title}",
              data: { trackable: true, trackable_type: 'Educator', trackable_id: educator.id } do %>
    <%= image_tag educator.image.url, class: "media-image listing_image" %>
    <h4><%= educator.title %></h4>
    <p><%= educator.description %></p>
    <span class="educator-open btn btn-primary btn-xs">Open <i class="fa fa-external-link"></i></span>
  <% end %>

  <% if policy(educator).update? %>
    <div class="educator-admin">
      <%= link_to 'Edit', edit_educator_path(educator) %>
    </div>
  <% end %>
</li>
