<li class="masonry-brick media-item educator-tile">
  <%= image_tag educator.image.url, class: "media-image listing_image" %>
  <h3 class="media-heading"><%= educator.title %></h3>
  <p><%= educator.description %></p>

  <%# Real link: opens the educator in a new tab %>
  <%= link_to educator.url, class: "educator-open btn btn-primary btn-xs",
              target: "_blank", rel: "noopener",
              title: "Open #{educator.title}" do %>
    Open <i class="fa fa-external-link"></i>
  <% end %>

  <%# Whole-tile link (positioned by dresa_overrides.scss - upstream dropped
      the .media-view overlay styles this pattern relies on) %>
  <%= link_to '', educator.url, class: 'media-view', target: '_blank', rel: 'noopener',
              title: "Open #{educator.title}" %>

  <% if policy(educator).update? %>
    <div class="educator-admin">
      <%= link_to 'Edit', edit_educator_path(educator) %>
    </div>
  <% end %>
</li>
