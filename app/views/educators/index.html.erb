<%# DRESA-65: search-engine description, canonical address, link-preview tags and structured data %>
<% content_for :og_header do %>
  <%= tag(:meta, property: "og:url", content: "https://dresa.org.au/educators") %>
  <%= tag(:meta, property: "og:type", content: "website") %>
  <%= tag(:meta, property: "og:image", content: asset_url(TeSS::Config.site['logo_open_graph'])) %>
  <%= tag(:meta, property: "og:title", content: "AI Educators for dataspaces | DReSA") %>
  <%= tag(:meta, property: "og:description", content: "Free AI learning assistants for dataspaces from the Australian Research Data Commons (ARDC): the Dataspace Educator answers questions from curated sources, and four guided coaches teach fundamentals, getting started, governance and technology.") %>
<% end %>
<% content_for :extra_head do %>
  <%= tag(:meta, name: "description", content: "Free AI learning assistants for dataspaces from the Australian Research Data Commons (ARDC): the Dataspace Educator answers questions from curated sources, and four guided coaches teach fundamentals, getting started, governance and technology.") %>
  <%= tag(:link, rel: "canonical", href: "https://dresa.org.au/educators") %>
  <script type="application/ld+json">{"@context": "https://schema.org", "@type": "CollectionPage", "name": "ARDC AI Educators for dataspaces", "url": "https://dresa.org.au/educators", "description": "Free AI learning assistants for dataspaces from the Australian Research Data Commons (ARDC): the Dataspace Educator answers questions from curated sources, and four guided coaches teach fundamentals, getting started, governance and technology.", "inLanguage": "en-AU", "publisher": {"@type": "Organization", "name": "Australian Research Data Commons", "url": "https://ardc.edu.au/"}, "hasPart": [{"@type": "LearningResource", "name": "Australian Dataspace Educator", "url": "https://dresa.org.au/dataspaces_ed/", "description": "Ask questions about dataspaces and get answers grounded in curated international and Australian sources, with source-validation banners.", "isAccessibleForFree": true, "learningResourceType": "AI tutor", "about": "Data spaces", "provider": {"@type": "Organization", "name": "Australian Research Data Commons"}}, {"@type": "LearningResource", "name": "Dataspaces 101 Coach", "url": "https://dresa.org.au/dataspaces_101/", "description": "A guided module on dataspace fundamentals with Socratic coaching and a knowledge check.", "isAccessibleForFree": true, "learningResourceType": "AI tutor", "about": "Data spaces", "provider": {"@type": "Organization", "name": "Australian Research Data Commons"}}, {"@type": "LearningResource", "name": "Dataspace Getting-Started Coach", "url": "https://dresa.org.au/dataspaces_start/", "description": "Plan the first steps of a dataspace initiative, anchored on your own project and ending with a 90-day plan.", "isAccessibleForFree": true, "learningResourceType": "AI tutor", "about": "Data spaces", "provider": {"@type": "Organization", "name": "Australian Research Data Commons"}}, {"@type": "LearningResource", "name": "Dataspace Governance Coach", "url": "https://dresa.org.au/dataspaces_governance/", "description": "Learn to build dataspace governance and a rulebook, using the Sitra rulebook method and IDSA Rulebook foundations.", "isAccessibleForFree": true, "learningResourceType": "AI tutor", "about": "Data spaces", "provider": {"@type": "Organization", "name": "Australian Research Data Commons"}}, {"@type": "LearningResource", "name": "Dataspace Technical Coach", "url": "https://dresa.org.au/dataspaces_tech/", "description": "Learn dataspace technology step by step: reference architecture, connectors, ODRL policies, the Dataspace Protocol and testbeds.", "isAccessibleForFree": true, "learningResourceType": "AI tutor", "about": "Data spaces", "provider": {"@type": "Organization", "name": "Australian Research Data Commons"}}], "isBasedOn": "https://github.com/au-research/AI-educators"}</script>
<% end %>
<div class="wrapper">
  <div id="content">
    <% if policy(Educator).create? %>
      <div style="margin-bottom: 1em;">
        <%= link_to new_educator_path, class: 'btn btn-primary' do %>
          <i class="fa fa-plus-square"></i> Add educator
        <% end %>
      </div>
    <% end %>

    <h1>Educators</h1>
    <p>
      Interactive AI learning assistants, grounded in curated and openly licensed sources.
      Want to build your own educator? Learn how in our open repository:
      <a href="https://github.com/au-research/AI-educators">github.com/au-research/AI-educators</a>.
      The Educator answers your questions; the Coaches run guided modules with lessons and a
      knowledge check. Expect the Coaches to ask before they tell.
      Click a tile to start a conversation.
    </p>

    <p class="muted" style="font-size: .92em;">
      <strong>What belongs here:</strong> interactive learning tools people <em>use</em> &mdash;
      AI educators and coaches, guided or interactive learning modules, and links to hosted
      learning environments (an LMS, Cogniti and similar). Things people simply read or watch
      &mdash; slides, recordings, guides &mdash; belong under <%= link_to "Materials", materials_path %>.
    </p>

    <% @educators.group_by { |e| e.category.presence || 'Dataspaces' }.each do |category, educators| %>
      <h2 class="educator-category"><%= category %></h2>
      <% if category == 'Dataspaces' %>
        <%# DRESA-63 (Oct 2026): the two Dataspaces 101 session recordings, hosted under /media/ %>
        <p class="muted" style="font-size: .92em; margin-top: -1.2em; margin-bottom: 1em;">
          New to dataspaces? Watch the Dataspaces 101 recordings first:
          <%= link_to 'Session 1 (51 min)', 'https://dresa.org.au/media/dataspaces-101/dataspaces-101-session-1.html' %> &middot;
          <%= link_to 'Session 2 (1 h 49 min)', 'https://dresa.org.au/media/dataspaces-101/dataspaces-101-session-2.html' %>.
          They are also listed under <%= link_to 'Materials', materials_path(q: 'Dataspaces 101') %>.
        </p>
      <% end %>
      <div class="educators-grid">
        <%= render partial: 'common/masonry_grid', locals: { objects: educators } %>
      </div>
    <% end %>

    <% if @educators.empty? %>
      <p class="muted">No educators registered yet.</p>
    <% end %>
  </div>
</div>
