<div class="wrapper">
  <div id="content">
    <% if policy(Educator).create? %>
      <div style="margin-bottom: 1em;">
        <%= link_to new_educator_path, class: 'btn btn-primary' do %>
          <i class="fa fa-plus-square"></i> Add educator
        <% end %>
      </div>
    <% end %>

    <h1>Educators</h1>
    <p>
      Interactive AI learning assistants, grounded in curated and openly licensed sources.
      The Educator answers your questions; the Coaches run guided modules with lessons and a
      knowledge check &mdash; expect the Coaches to ask before they tell.
      Click a tile to start a conversation.
    </p>

    <p class="muted" style="font-size: .92em;">
      <strong>What belongs here:</strong> interactive learning tools people <em>use</em> &mdash;
      AI educators and coaches, guided or interactive learning modules, and links to hosted
      learning environments (an LMS, Cogniti and similar). Things people simply read or watch
      &mdash; slides, recordings, guides &mdash; belong under <%= link_to "Materials", materials_path %>.
    </p>

    <% @educators.group_by { |e| e.category.presence || 'Dataspaces' }.each do |category, educators| %>
      <h2 class="educator-category"><%= category %></h2>
      <% if category == 'Dataspaces' %>
        <%# DRESA-63 (Oct 2026): the two Dataspaces 101 session recordings, hosted under /media/ %>
        <p class="muted" style="font-size: .92em; margin-top: -1.2em; margin-bottom: 1em;">
          New to dataspaces? Watch the Dataspaces 101 recordings first:
          <%= link_to 'Session 1 (51 min)', 'https://dresa.org.au/media/dataspaces-101/dataspaces-101-session-1.html' %> &middot;
          <%= link_to 'Session 2 (1 h 49 min)', 'https://dresa.org.au/media/dataspaces-101/dataspaces-101-session-2.html' %>.
          They are also listed under <%= link_to 'Materials', materials_path(q: 'Dataspaces 101') %>.
        </p>
      <% end %>
      <div class="educators-grid">
        <%= render partial: 'common/masonry_grid', locals: { objects: educators } %>
      </div>
    <% end %>

    <% if @educators.empty? %>
      <p class="muted">No educators registered yet.</p>
    <% end %>
  </div>
</div>
